import os
import warnings

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import requests
import seaborn as sns
import statsmodels.formula.api as smf
from scipy import stats

try:
    from arch import arch_model
    HAS_ARCH = True
except ImportError:
    HAS_ARCH = False

try:
    import yfinance as yf
    HAS_YF = True
except ImportError:
    HAS_YF = False

warnings.filterwarnings("ignore")

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------
TWELVE_API_KEY = os.environ.get("TWELVE_DATA_API_KEY")
SHOW_PLOTS = True

PEG = 1.0
DEPEG_THRESHOLD = 0.01       # |price - 1| above this starts a de-peg episode
RECOVERY_THRESHOLD = 0.005   # |price - 1| below this ends the episode
ANNUALIZATION = 365          # crypto trades every day (the original used 252)
MIN_OBS = 30

# PSPI components are put on a comparable scale before weighting.
# (The original mixed raw price deviations with "days / 30", so one term dominated.)
# These scales are judgement calls; PSPI rankings can be sensitive to them.
PSPI_WEIGHTS = {"avg_dev": 0.4, "recovery_days": 0.3, "max_dev": 0.2, "price_std": 0.1}
PSPI_SCALES = {"avg_dev": 0.01, "recovery_days": 30.0, "max_dev": 0.05, "price_std": 0.01}

MECH_NAMES = {1: "Fiat-backed", 2: "Crypto-backed", 3: "Algorithmic", 4: "Hybrid"}

STABLECOINS = {
    "USDT": {"name": "Tether", "mech_type": 1, "age_months": 120,
             "twelve": ["USDT/USD"], "yahoo": ["USDT-USD"]},
    "USDC": {"name": "USD Coin", "mech_type": 1, "age_months": 72,
             "twelve": ["USDC/USD"], "yahoo": ["USDC-USD"]},
    "DAI": {"name": "Dai", "mech_type": 2, "age_months": 84,
            "twelve": ["DAI/USD"], "yahoo": ["DAI-USD"]},
    # NOTE: BUSD was wound down (minting stopped 2023). Its quotes are thin and
    # may contain bad prints. Consider replacing it with FDUSD or TUSD.
    "BUSD": {"name": "Binance USD", "mech_type": 1, "age_months": 60,
             "twelve": ["BUSD/USD"], "yahoo": ["BUSD-USD"]},
    "FRAX": {"name": "Frax", "mech_type": 4, "age_months": 48,
             "twelve": ["FRAX/USD"], "yahoo": ["FRAX-USD"]},
}


# ----------------------------------------------------------------------------
# Data acquisition
# ----------------------------------------------------------------------------
def standardize(df, date_col, close_col):
    """Return a clean frame with tz-naive daily dates, close and gap-safe returns."""
    out = pd.DataFrame({
        "datetime": pd.to_datetime(df[date_col], utc=True).dt.tz_localize(None).dt.normalize(),
        "close": pd.to_numeric(df[close_col], errors="coerce"),
    })
    out = out.dropna()
    out = out[out["close"] > 0]
    out = (out.sort_values("datetime")
              .drop_duplicates("datetime", keep="last")
              .reset_index(drop=True))
    # Only compute a return when the previous observation is exactly 1 day earlier,
    # otherwise a multi-day gap would be treated as a one-day return.
    gap_days = out["datetime"].diff().dt.days
    out["returns"] = out["close"].pct_change().where(gap_days == 1)
    return out


def fetch_twelve_data(symbols, outputsize=400):
    if not TWELVE_API_KEY:
        print("    TWELVE_DATA_API_KEY not set - skipping Twelve Data")
        return pd.DataFrame()
    for symbol in symbols:
        print(f"    Trying Twelve Data: {symbol}")
        try:
            resp = requests.get(
                "https://api.twelvedata.com/time_series",
                params={"symbol": symbol, "interval": "1day",
                        "outputsize": outputsize, "apikey": TWELVE_API_KEY},
                timeout=15,
            )
            data = resp.json()
        except (requests.RequestException, ValueError) as exc:
            print(f"      request failed: {exc}")
            continue
        if data.get("status") == "error" or "values" not in data:
            print(f"      API error: {data.get('message', 'no data')}")
            continue
        df = standardize(pd.DataFrame(data["values"]), "datetime", "close")
        if len(df) >= MIN_OBS:
            return df
    return pd.DataFrame()


def fetch_yahoo(symbols, period="1y"):
    if not HAS_YF:
        print("    yfinance not installed - skipping Yahoo Finance")
        return pd.DataFrame()
    for symbol in symbols:
        print(f"    Trying Yahoo Finance: {symbol}")
        try:
            hist = yf.Ticker(symbol).history(period=period).reset_index()
        except Exception as exc:  # yfinance raises many different exception types
            print(f"      failed: {exc}")
            continue
        if hist.empty or "Close" not in hist.columns:
            continue
        df = standardize(hist, hist.columns[0], "Close")
        if len(df) >= MIN_OBS:
            return df
    return pd.DataFrame()


def report_data_quality(df, symbol):
    span_days = (df["datetime"].iloc[-1] - df["datetime"].iloc[0]).days + 1
    missing = span_days - len(df)
    max_dev = (df["close"] - PEG).abs().max()
    print(f"   {len(df)} obs, {df['datetime'].min().date()} -> {df['datetime'].max().date()}, "
          f"price ${df['close'].min():.4f}-${df['close'].max():.4f}")
    if missing > 0:
        print(f"   WARNING: {missing} calendar days missing (returns across gaps are excluded)")
    if max_dev > 0.05:
        print(f"   WARNING: max deviation from peg is {max_dev:.1%} - verify this is a real "
              f"de-peg and not a bad print")


def get_stablecoin_data(symbol, cfg):
    print(f"\nFetching {symbol} ({cfg['name']})...")
    df = fetch_twelve_data(cfg["twelve"])
    if df.empty:
        print("   Twelve Data unavailable, trying Yahoo Finance...")
        df = fetch_yahoo(cfg["yahoo"])
    if df.empty:
        print(f"   No data for {symbol}")
        return df
    report_data_quality(df, symbol)
    return df


# ----------------------------------------------------------------------------
# Metrics
# ----------------------------------------------------------------------------
def depeg_recovery_days(df):
    """Days each de-peg episode took to recover. Unrecovered episodes are
    right-censored at the end of the sample (counted up to the last date)."""
    dev = (df["close"] - PEG).abs().to_numpy()
    dates = df["datetime"].to_numpy()
    depegged = dev > DEPEG_THRESHOLD
    starts = np.where(depegged & ~np.r_[False, depegged[:-1]])[0]
    durations = []
    for s in starts:
        rec = np.where(dev[s + 1:] <= RECOVERY_THRESHOLD)[0]
        end = s + 1 + rec[0] if len(rec) else len(dev) - 1
        durations.append((dates[end] - dates[s]) / np.timedelta64(1, "D"))
    return durations


def compute_pspi(df):
    if len(df) < MIN_OBS:
        return None
    dev = (df["close"] - PEG).abs()
    episodes = depeg_recovery_days(df)
    comps = {
        "avg_dev": dev.mean(),
        # No de-pegs -> 0. (The original defaulted to 1, which added a constant
        # ~0.01 to every coin's PSPI and flattened the differences.)
        "recovery_days": float(np.mean(episodes)) if episodes else 0.0,
        # Two-sided: upward spikes (like BUSD's) count too.
        "max_dev": dev.max(),
        "price_std": df["close"].std(),
    }
    pspi = sum(PSPI_WEIGHTS[k] * comps[k] / PSPI_SCALES[k] for k in comps)
    return {"pspi": pspi, "n_depeg_episodes": len(episodes), **comps}


def volatility_measures(df):
    r = df["returns"].dropna()
    if len(r) < MIN_OBS:
        return {}
    var95, var99 = np.percentile(r, 5), np.percentile(r, 1)
    out = {
        "volatility_ann": r.std() * np.sqrt(ANNUALIZATION),
        "var_95": abs(var95),
        "var_99": abs(var99),
        "es_95": abs(r[r <= var95].mean()),
        "es_99": abs(r[r <= var99].mean()),
    }
    if HAS_ARCH:
        try:
            fit = arch_model(r * 100, vol="Garch", p=1, q=1).fit(disp="off")
            out["garch_daily_vol"] = fit.conditional_volatility.iloc[-1] / 100
        except Exception:
            pass
    return out


def correlation_analysis(price_data):
    # Align by DATE (the original sliced the last N values positionally,
    # which silently misaligns series that have different gaps).
    wide = pd.concat({s: d.set_index("datetime")["returns"] for s, d in price_data.items()},
                     axis=1).dropna()
    if len(wide) < MIN_OBS:
        print("  Not enough overlapping observations for correlations")
        return None
    corr = wide.corr()
    avg = {s: corr[s].drop(s).mean() for s in corr.columns}
    return {"matrix": corr, "average": avg, "n_obs": len(wide)}


def build_panel(price_data):
    frames = []
    for s, d in price_data.items():
        f = d[["datetime", "close"]].copy()
        f["symbol"] = s
        f["mech_type"] = STABLECOINS[s]["mech_type"]
        f["abs_dev"] = (f["close"] - PEG).abs()
        frames.append(f)
    return pd.concat(frames, ignore_index=True)


# ----------------------------------------------------------------------------
# Plots
# ----------------------------------------------------------------------------
def plot_price(df, symbol):
    plt.figure(figsize=(10, 5))
    plt.plot(df["datetime"], df["close"], label=f"{symbol} close")
    plt.axhline(PEG, color="red", linestyle="--", label="Peg ($1)")
    plt.title(f"{symbol} price over time")
    plt.xlabel("Date")
    plt.ylabel("Price (USD)")
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()


def plot_pspi(ranking):
    plt.figure(figsize=(8, 4))
    plt.bar([r[0] for r in ranking], [r[1] for r in ranking], color="skyblue")
    plt.title("PSPI ranking (lower = more stable)")
    plt.ylabel("PSPI")
    plt.grid(axis="y")
    plt.tight_layout()
    plt.show()


def plot_volatility(results):
    syms = [s for s, r in results.items() if r["vol"]]
    x = np.arange(len(syms))
    plt.figure(figsize=(10, 5))
    plt.bar(x - 0.2, [results[s]["vol"]["volatility_ann"] for s in syms], 0.4,
            label="Annualized volatility")
    plt.bar(x + 0.2, [results[s]["vol"]["var_95"] for s in syms], 0.4, label="VaR 95% (daily)")
    plt.xticks(x, syms)
    plt.title("Volatility and VaR")
    plt.legend()
    plt.grid(axis="y")
    plt.tight_layout()
    plt.show()


def plot_corr(corr):
    plt.figure(figsize=(8, 6))
    sns.heatmap(corr, annot=True, fmt=".2f", cmap="coolwarm", center=0)
    plt.title("Stablecoin daily return correlations")
    plt.tight_layout()
    plt.show()


# ----------------------------------------------------------------------------
# Analysis
# ----------------------------------------------------------------------------
def run_analysis(price_data):
    results = {s: {"pspi": compute_pspi(d), "vol": volatility_measures(d)}
               for s, d in price_data.items()}

    if SHOW_PLOTS:
        for s, d in price_data.items():
            plot_price(d, s)

    print("\n1. PRICE STABILITY PERFORMANCE INDEX (PSPI, lower = better)")
    print("-" * 60)
    ranking = []
    for s, r in results.items():
        p = r["pspi"]
        if not p:
            continue
        ranking.append((s, p["pspi"], STABLECOINS[s]["mech_type"]))
        print(f"{s:5} ({MECH_NAMES[STABLECOINS[s]['mech_type']]:13}) PSPI={p['pspi']:.4f} | "
              f"avg dev={p['avg_dev']:.5f}, max dev={p['max_dev']:.5f}, "
              f"de-peg episodes={p['n_depeg_episodes']}, mean recovery={p['recovery_days']:.1f}d")
    ranking.sort(key=lambda x: x[1])
    print("\nRanking:")
    for i, (s, v, m) in enumerate(ranking, 1):
        print(f"  {i}. {s} ({MECH_NAMES[m]}): {v:.4f}")
    if SHOW_PLOTS and ranking:
        plot_pspi(ranking)

    print("\n2. VOLATILITY")
    print("-" * 60)
    for s, r in results.items():
        v = r["vol"]
        if v:
            extra = f", GARCH daily vol={v['garch_daily_vol']:.5f}" if "garch_daily_vol" in v else ""
            print(f"{s:5}: ann. vol={v['volatility_ann']:.4f}, VaR95={v['var_95']:.6f}, "
                  f"ES95={v['es_95']:.6f}{extra}")
    if SHOW_PLOTS:
        plot_volatility(results)

    print("\n3. CORRELATIONS")
    print("-" * 60)
    if len(price_data) >= 2:
        corr = correlation_analysis(price_data)
        if corr:
            print(f"Based on {corr['n_obs']} dates common to all coins")
            print(corr["matrix"].round(4))
            for s, v in corr["average"].items():
                print(f"  avg correlation {s}: {v:.4f}")
            if SHOW_PLOTS:
                plot_corr(corr["matrix"])

    print("\n4. PANEL REGRESSION: |peg deviation| ~ mechanism type")
    print("-" * 60)
    panel = build_panel(price_data)
    if panel["mech_type"].nunique() >= 2:
        # Daily observations instead of 5 coin-level rows, HAC standard errors for
        # autocorrelation. The original regressed PSPI on avg_deviation and volatility,
        # which are components of PSPI (circular, R^2 = 1) with n=5 rows.
        model = smf.ols("abs_dev ~ C(mech_type)", data=panel).fit(
            cov_type="HAC", cov_kwds={"maxlags": 5})
        print(model.summary().tables[1])
    else:
        print("Need at least two mechanism types for this regression")

    print("\n5. HYPOTHESIS TEST: do mechanisms differ in peg deviation?")
    print("-" * 60)
    groups = {m: g["abs_dev"].to_numpy() for m, g in panel.groupby("mech_type")}
    for m, arr in groups.items():
        coins = sorted(panel.loc[panel["mech_type"] == m, "symbol"].unique())
        print(f"  {MECH_NAMES[m]:14} coins={coins} mean={arr.mean():.6f} median={np.median(arr):.6f}")
    if len(groups) >= 2:
        h, p = stats.kruskal(*groups.values())
        print(f"  Kruskal-Wallis H={h:.2f}, p={p:.4g}")
        print("  Caveat: daily deviations are autocorrelated (p-values are optimistic) and "
              "mechanism groups contain only 1-3 coins, so this cannot support general "
              "claims about mechanisms.")
    return results


def main():
    print("=" * 80)
    print("STABLECOIN STABILITY ANALYSIS")
    print("=" * 80)
    price_data = {}
    for symbol, cfg in STABLECOINS.items():
        df = get_stablecoin_data(symbol, cfg)
        if not df.empty:
            price_data[symbol] = df
    if not price_data:
        print("\nERROR: no data could be fetched for any stablecoin")
        return
    print(f"\nLoaded {len(price_data)}/{len(STABLECOINS)} stablecoins")
    run_analysis(price_data)


if __name__ == "__main__":
    main()
